# blog-agent - copy this file to blog-agent/.env and fill in the real values.
# .env is gitignored (the repo's .gitignore covers `.env` at any depth); never
# commit it.

# The script reads the process environment only. Node 20.6+ can load the file
# for you, with no dependency needed:
#
#   node --env-file=blog-agent/.env blog-agent/generate-draft.mjs          # dry run
#   node --env-file=blog-agent/.env blog-agent/generate-draft.mjs --save   # insert as draft
#
# If a required variable is missing the script exits and names the variable.
# Values are never printed.

# ============================================================================
#  Supabase
# ============================================================================
# Dashboard -> Project Settings -> Data API. No trailing slash.
SUPABASE_URL=

# Dashboard -> Project Settings -> API Keys -> service_role "secret" key.
# Server-side only (it bypasses RLS): used to read every post, drafts included,
# and to insert the new draft row.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
#  Gemini (primary provider)
# ============================================================================
# API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id from the Gemini docs, e.g. gemini-2.5-flash
GEMINI_MODEL=

# ============================================================================
#  OpenRouter (fallback provider, used only when Gemini fails)
# ============================================================================
# API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional - defaults to "openrouter/free" when unset or empty.
OPENROUTER_MODEL=openrouter/free
